{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "example-stdio": {
      "type": "stdio",
      "command": "./bin/server",
      "args": ["--root", "${PLUGIN_ROOT}"],
      "env": {
        "DATA_DIR": "${PLUGIN_DATA}"
      },
      "cwd": "${PLUGIN_ROOT}"
    },
    "example-remote": {
      "type": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_TOKEN}"
      }
    }
  }
}
